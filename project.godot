; Merge Harvest -- free Windows merge game.
config_version=5

[application]

config/name="Merge Harvest"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.4", "C#", "GL Compatibility")
config/description="Unlimited-energy offline food merge game"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=2560
window/size/window_height_override=1440
window/size/mode=0
window/size/resizable=true
window/stretch/mode="viewport"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[dotnet]

project/assembly_name="MergeHarvest"
